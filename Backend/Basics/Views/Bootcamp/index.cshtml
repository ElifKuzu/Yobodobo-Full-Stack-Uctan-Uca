@model List<Bootcamp>
    @await Html.PartialAsync( partialViewName: "_Header", Model.FirstOrDefault())

    <div class="row">
        @foreach (var course in Model   )
        {
            @if(course.IsHome && course.IsActive)
            {
            <div class="col-3">
                <div class="card">
                    <img src="~/images/@course.Image" class="card-img-top" alt="">
                    <div class="card-body">
                        <h5 class="card-title">@course.Name</h5>
                        <p class="card-text">@course.Description</p>
                        <a href="@Url.Action("Details", "Bootcamp", new { id = course.Id })" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
            }
        }
    </div>
